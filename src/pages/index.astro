---
import Layout from "@/layouts/Layout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import LogEntryItem from "@/components/LogEntry.astro";
import presentation from "@/data/presentation";
import whoami from "@/data/whoami";
import fetchApi from "@/lib/fetch-api";
import { getPosts } from "@/lib/posts";
import { buildLog, postToEntry } from "@/lib/log";
import formatDate from "@/utils/formatDate";
import type Post from "@/interfaces/post";
import type Projects from "@/interfaces/projects";

const posts: Post[] = await getPosts({ limit: 5 });

const projects: Projects[] = await fetchApi<Projects[]>({
  endpoint: "projects",
  wrappedByKey: "data",
  query: {
    sort: ["publishedAt:desc"],
    pagination: { page: 1, pageSize: 6 },
  },
  defaultReturn: [],
});

// The newest post is featured in the HEAD block; everything else forms the log.
const [latestPost, ...olderPosts] = posts;
const head = latestPost ? postToEntry(latestPost) : undefined;
const log = buildLog(olderPosts, projects);
---

<Layout>
  <!-- Hero -->
  <section aria-labelledby="hero-title" class="border-b-2 border-fg pb-12 pt-[clamp(40px,7vw,88px)]">
    <h1
      id="hero-title"
      class="display text-[clamp(60px,13vw,172px)] leading-[0.86] tracking-[-0.04em]"
    >
      {
        presentation.headline.map((line, i) => (
          <>
            {i > 0 && <br />}
            <span class:list={{ "text-accent": line.accent }}>{line.text}</span>
          </>
        ))
      }
    </h1>
    <div class="mt-10 grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-x-12 gap-y-6">
      <p class="text-xl font-semibold">{presentation.intro}</p>
      <p class="text-muted">{presentation.sandbox}</p>
      <dl class="label grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[13px] tracking-[0.04em]">
        {
          presentation.stack.map((row) => (
            <>
              <dt class="text-muted">{row.label}</dt>
              <dd>{row.value}</dd>
            </>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Whoami teaser -->
  <section id="whoami" aria-labelledby="whoami-title" class="flex flex-wrap gap-6 border-b-2 border-fg py-12">
    <SectionHeading id="whoami-title" index={0} title="Whoami" command="$ whoami" />
    <div
      class="grid min-w-0 flex-[999_1_640px] grid-cols-[repeat(auto-fit,minmax(220px,1fr))] border-2 border-fg"
    >
      <div class="border-b border-r border-rule p-6">
        <p class="label mb-1.5 text-muted">Writing code since</p>
        <p class="display text-5xl leading-none">{whoami.codingSince}</p>
      </div>
      <div class="border-b border-r border-rule p-6">
        <p class="label mb-1.5 text-muted">Currently</p>
        <p class="display text-[28px] leading-[1.05]">{whoami.current}</p>
      </div>
      <a
        href="/whoami"
        class="flex flex-col justify-between gap-4 bg-accent p-6 text-on-accent hover:opacity-90"
      >
        <span class="label">Trajectory, stack, how I work</span>
        <span class="display text-[32px] leading-none">More about me →</span>
      </a>
    </div>
  </section>

  <!-- Log -->
  <section id="log" aria-labelledby="log-title" class="flex flex-wrap gap-6 border-b-2 border-fg py-12">
    <SectionHeading id="log-title" index={1} title="Log" command="$ git log --oneline" />

    <ol role="list" class="min-w-0 flex-[999_1_640px] border-l-2 border-fg">
      <li class="relative pb-8 pl-8">
        <span aria-hidden="true" class="absolute -left-[9px] top-1 h-4 w-4 bg-accent"></span>
        <p class="label mb-2.5 text-accent">
          {head ? `HEAD · ${formatDate(head.date)} · Latest post` : "HEAD · Now · Writing"}
        </p>
        <div class="flex flex-wrap items-center justify-between gap-4 bg-accent px-7 py-6 text-on-accent">
          <div class="min-w-0">
            <h3 class="display mb-1 text-[34px] leading-none">
              {head ? head.title : "First post in progress"}
            </h3>
            <p>{head ? head.description : "Backend notes, written down so they stick."}</p>
          </div>
          {
            head ? (
              <a href={head.href} class="label border-b-2 border-on-accent py-3 text-[13px]">
                Read it →
              </a>
            ) : (
              <a
                href="https://github.com/yavurb"
                target="_blank"
                rel="noreferrer"
                class="label border-b-2 border-on-accent py-3 text-[13px]"
              >
                Watch on GitHub ↗
              </a>
            )
          }
        </div>
      </li>

      {log.map((entry) => <LogEntryItem entry={entry} />)}

      <li class="label pl-8 pt-2 text-muted">
        <!-- Easter egg trigger: looks like plain text on purpose. -->
        <button
          type="button"
          data-egg-open
          title="git checkout root"
          class="label cursor-text bg-transparent p-0 text-muted hover:text-accent"
        >
          (root commit)
        </button>
      </li>
    </ol>
  </section>

  <!-- Writing -->
  <section
    id="writing"
    aria-labelledby="writing-title"
    class="paper flex flex-wrap gap-6 border-b-2 border-fg py-12"
  >
    <SectionHeading id="writing-title" index={2} title="Writing" />
    <div class="min-w-0 flex-[999_1_640px] border-2 border-fg bg-surface">
      <div class="flex flex-wrap items-center justify-between gap-4 px-7 py-5">
        <p class="font-mono text-sm">
          <span class="text-accent">$</span> ls posts/
          <span class="text-muted">
            → {posts.length === 0 ? "0 files · first one drafting" : `${posts.length}${posts.length === 5 ? "+" : ""} files`}
          </span>
        </p>
        <a href="/posts" class="label border-b-2 border-accent py-3 text-[13px] hover:text-accent">All posts →</a>
      </div>
      {
        posts.length > 0 && (
          <ol role="list" class="border-t-2 border-fg">
            {posts.slice(0, 3).map((post) => (
              <li class="border-b border-rule last:border-b-0">
                <a
                  href={`/posts/${post.id}`}
                  class="grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] items-baseline gap-x-6 gap-y-1 px-7 py-4 hover:text-accent"
                >
                  <span class="display text-[26px] leading-none">{post.title}</span>
                  <span class="label text-muted sm:text-right">{formatDate(new Date(post.published_at))}</span>
                </a>
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" aria-labelledby="contact-title" class="pb-12 pt-16">
    <h2 id="contact-title" class="mb-6 font-mono text-sm font-medium text-accent">
      <span class="section-index">03</span> — Contact · git push origin hello
    </h2>
    <a
      href={`mailto:${presentation.mail}`}
      class="display inline-block break-all border-b-[6px] border-accent text-[clamp(36px,8vw,104px)] leading-[0.95] hover:text-accent"
    >
      {presentation.mail}
    </a>
  </section>
</Layout>
