---
import Layout from "@/layouts/Layout.astro";
import LogEntryItem from "@/components/LogEntry.astro";
import { getPosts } from "@/lib/posts";
import { postToEntry } from "@/lib/log";

const entries = (await getPosts()).map(postToEntry);
---

<Layout
  title="Writing — yurb.dev"
  description="Backend notes — APIs, databases, infrastructure — written down so they stick."
>
  <section
    aria-labelledby="posts-title"
    class="flex flex-wrap items-end justify-between gap-6 border-b-2 border-fg pb-10 pt-[clamp(40px,7vw,80px)]"
  >
    <h1
      id="posts-title"
      class="display text-[clamp(64px,13vw,168px)] leading-[0.86] tracking-[-0.04em]"
    >
      <span class="label mb-4 block text-sm font-medium normal-case text-accent"
        >02 — $ git log -- posts/</span
      >
      Writing
    </h1>
    <p class="max-w-[36ch] text-muted">
      Backend notes — APIs, databases, infrastructure — written down so they stick. Newest first.
    </p>
  </section>

  <!-- The log sits on grid paper, like the Writing section on the home page. -->
  <section aria-label="All posts" class="paper mb-24 border-b-2 border-fg py-12">
    {
      entries.length > 0 ? (
        <ol role="list" class="border-l-2 border-fg">
          {entries.map((entry, i) => (
            <LogEntryItem entry={entry} head={i === 0} />
          ))}
          <li class="label pl-8 text-muted">(root commit)</li>
        </ol>
      ) : (
        <div class="flex flex-wrap items-center justify-between gap-4 border-2 border-fg bg-surface p-7">
          <p class="font-mono text-sm">
            <span class="text-accent">$</span> ls posts/{" "}
            <span class="text-muted">→ 0 files · the first one is drafting</span>
          </p>
          <a
            href="https://github.com/yavurb"
            target="_blank"
            rel="noreferrer"
            class="label border-b-2 border-accent py-3 text-[13px] hover:text-accent"
          >
            Watch on GitHub ↗
          </a>
        </div>
      )
    }
  </section>
</Layout>
