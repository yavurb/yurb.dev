---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import SEOTags from "@/components/seo/SEOTags.astro";
import type { HeadTags } from "@/utils/types/HeadTags";

import "@fontsource-variable/archivo/wdth.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@/styles/tailwind.css";
import "@/styles/post.css";

export type Props = HeadTags;

const headTags = Astro.props;
---

<!doctype html>
<html lang="en">
  <SEOTags {...headTags}>
    <meta name="color-scheme" content="light dark" />
    <!-- Apply a saved theme choice before first paint (no light/dark flash). -->
    <script is:inline>
      try {
        const saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") {
          document.documentElement.dataset.theme = saved;
        }
      } catch (_) {}
    </script>
  </SEOTags>

  <body class="flex min-h-screen flex-col bg-bg text-[17px] leading-relaxed text-fg">
    <a
      href="#content"
      class="label sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-accent focus:px-4 focus:py-3 focus:text-on-accent"
      >Skip to content</a
    >
    <Header />
    <main id="content" class="mx-auto w-full max-w-site flex-1 px-6">
      <slot />
    </main>
    <Footer />
  </body>
</html>
