---
type Props = {
  id: string;
  index: number;
  title: string;
  /** Optional mono line under the title, e.g. "$ git log --oneline". */
  command?: string;
};

const { id, index, title, command } = Astro.props;
---

<div class="flex-[1_1_240px]">
  <h2 id={id} class="display text-[44px] leading-none">
    <span class="label mb-2.5 block text-sm font-medium normal-case text-accent"
      >{String(index).padStart(2, "0")}</span
    >
    {title}
  </h2>
  {command && <p class="mt-3 font-mono text-[13px] text-muted">{command}</p>}
</div>
