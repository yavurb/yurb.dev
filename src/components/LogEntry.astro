---
import formatDate from "@/utils/formatDate";
import type { LogEntry } from "@/lib/log";

type Props = {
  entry: LogEntry;
  /** The newest entry: accent square marker + "HEAD" label. */
  head?: boolean;
};

const { entry, head = false } = Astro.props;

const kindLabel = { post: "Post", project: "Project", site: "Site" }[entry.kind];
const meta = [
  head ? "HEAD" : null,
  formatDate(entry.date),
  kindLabel,
  entry.readingTime ? `${entry.readingTime} min` : null,
]
  .filter(Boolean)
  .join(" · ");

const tags = entry.tags.map((tag) => `+${tag.toLowerCase()}`).join(" ");
const Tag = entry.href ? "a" : "div";
const linkProps = entry.href
  ? {
      href: entry.href,
      ...(entry.external ? { target: "_blank", rel: "noreferrer" } : {}),
    }
  : {};
---

<li class="relative pb-2 pl-8">
  <span
    aria-hidden="true"
    class:list={[
      "absolute",
      head ? "-left-[9px] top-0.5 h-4 w-4 bg-accent" : "-left-[7px] top-1 h-3 w-3 bg-fg",
    ]}
  ></span>
  <p class:list={["label", head ? "text-accent" : "text-muted"]}>{meta}</p>
  <Tag
    {...linkProps}
    class:list={[
      "group mb-5 grid gap-x-6 gap-y-2 border-b border-rule pb-7 pt-2.5",
      "grid-cols-[repeat(auto-fit,minmax(220px,1fr))] items-baseline",
      entry.href && "hover:text-accent",
    ]}
  >
    <span class="display text-[clamp(28px,4vw,40px)] leading-none">
      {entry.title}
      {entry.external && entry.href && <span aria-hidden="true"> ↗</span>}
      {entry.external && entry.href && <span class="sr-only">(opens in a new tab)</span>}
    </span>
    {entry.description && <span class="text-muted">{entry.description}</span>}
    {tags && <span class="label text-muted">{tags}</span>}
  </Tag>
</li>
