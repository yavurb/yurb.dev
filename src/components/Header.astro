---
import ThemeToggle from "@/components/ThemeToggle.astro";
import removeTrailingSlash from "@/utils/removeTrailingSlash";
import presentation from "@/data/presentation";

const pathname = removeTrailingSlash(Astro.url.pathname) || "/";

const links = [
  { href: "/whoami", label: "Whoami", match: (p: string) => p === "/whoami" },
  { href: "/#log", label: "Log", match: (p: string) => p === "/" },
  { href: "/posts", label: "Writing", match: (p: string) => p.startsWith("/posts") },
  { href: "/#contact", label: "Contact", match: () => false },
];
---

<header
  class="label mx-auto flex w-full max-w-site flex-wrap items-center justify-between gap-4 px-6 py-5 text-[13px]"
>
  <a href="/" class="flex min-h-[44px] items-center gap-2.5 font-medium hover:text-accent">
    <span aria-hidden="true" class="h-2.5 w-2.5 bg-accent"></span>
    {presentation.name} / yurb.dev
  </a>

  <nav aria-label="Main" class="flex flex-wrap items-center gap-1">
    {
      links.map((link, index) => {
        const active = link.match(pathname);
        return (
          <a
            href={link.href}
            aria-current={active ? "page" : undefined}
            class:list={[
              "border-b-2 px-2.5 py-3 hover:text-accent",
              active ? "border-accent text-accent" : "border-transparent",
            ]}
          >
            {`${String(index).padStart(2, "0")} ${link.label}`}
          </a>
        );
      })
    }
    <span class="ml-2"><ThemeToggle /></span>
  </nav>
</header>
