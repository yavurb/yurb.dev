---
import presentation from "@/data/presentation";

const year = new Date().getFullYear();
---

<footer
  class="label mx-auto flex w-full max-w-site flex-wrap items-center justify-between gap-3 px-6 pb-8 pt-5 text-muted"
>
  <span>{`© ${year} ${presentation.name} · main@HEAD`}</span>
  <ul role="list" class="flex flex-wrap gap-1">
    {
      presentation.socials.map((social) => (
        <li>
          <a
            href={social.link}
            target="_blank"
            rel="noreferrer"
            class="inline-block px-2 py-3 text-fg hover:text-accent"
          >
            {social.label}
          </a>
        </li>
      ))
    }
  </ul>
</footer>
